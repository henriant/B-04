# Local web API origin. The web dev server reads this file from the repository root.
VITE_API_BASE_URL=http://localhost:8790

# Local API origins for Expo. Android emulator uses 10.0.2.2 to reach the host machine.
EXPO_PUBLIC_API_URL=http://localhost:8790
EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:8790

# Generate a private random value for local Better Auth sessions.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:8790

# IGDB/Twitch credentials are required for live game search.
# Create your own credentials; do not commit real values.
IGDB_CLIENT_ID=replace-with-your-igdb-client-id
IGDB_CLIENT_SECRET=replace-with-your-igdb-client-secret
