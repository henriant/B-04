{
  "name": "backlog-defeater",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@12.16.1",
  "description": "Monorepo for BacklogDefeater: webapp (RedwoodSDK) + mobilapp (Expo), pnpm workspaces",
  "scripts": {
    "dev:web": "corepack pnpm --filter web dev",
    "build:web": "corepack pnpm --filter web build",
    "release:web": "corepack pnpm --filter web release",
    "start:mobile": "corepack pnpm --filter mobile start",
    "android": "corepack pnpm --filter mobile android",
    "ios": "corepack pnpm --filter mobile ios",
    "db:local:migrate": "corepack pnpm --filter d1-http run db:migrate:local",
    "dev:api:local": "corepack pnpm --filter d1-http run dev:local",
    "dev:api:local:lan": "corepack pnpm --filter d1-http run dev:local:lan",
    "lint": "corepack pnpm -r --if-present lint",
    "test": "corepack pnpm exec vitest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.16",
    "dotenv": "^18.0.4",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.15"
  }
}