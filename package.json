{
  "name": "backlog-defeater",
  "private": true,
  "version": "0.0.1",
  "description": "Monorepo for BacklogDefeater: webapp (RedwoodSDK) + mobilapp (Expo), pnpm workspaces",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "release:web": "pnpm --filter web release",
    "start:mobile": "pnpm --filter mobile start",
    "android": "pnpm --filter mobile android",
    "ios": "pnpm --filter mobile ios",
    "lint": "pnpm -r --if-present lint"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.15"
  }
}